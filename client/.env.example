# Cohort — Client environment variables
# Copy to .env to apply locally (never commit .env)

# API mode switch:
#   false = localStorage mock (default, works offline, no backend needed)
#   true  = real Express + MongoDB backend
VITE_USE_REAL_API=false

# Backend base URL (only used when VITE_USE_REAL_API=true)
VITE_API_URL=http://localhost:5000/api
